# --- PostgreSQL ---
POSTGRES_USER=gobtools
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gobtools

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=changeme-please-use-a-strong-secret

# --- LLM Provider ---
LLM_PROVIDER=ollama        # ollama | openai | anthropic | gemini | mistral | openrouter
LLM_MODEL=qwen2.5:1.5b

# --- Ollama (par défaut via le conteneur intégré) ---
# Laissez vide pour utiliser le conteneur ollama du docker-compose
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://192.168.1.x:11434  # machine distante

# --- API Keys (uniquement si LLM_PROVIDER ≠ ollama) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
MISTRAL_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Installation de modèles Ollama supplémentaires ---
# Séparés par des espaces : "llama3.2 nomic-embed-text"
OLLAMA_EXTRA_MODELS=

# --- Upload PDF ---
PDF_MAX_SIZE_MB=30

# --- Export PDF ---
# Chemin vers wkhtmltopdf (optionnel, utilisé si installé)
# WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf
