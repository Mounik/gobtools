# --- PostgreSQL ---
POSTGRES_USER=gobtools
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gobtools

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=changeme-please-use-a-strong-secret

# --- LLM Provider ---
LLM_PROVIDER=ollama        # ollama | openai | anthropic | gemini | mistral | openrouter
LLM_MODEL=qwen2.5:1.5b

# --- Ollama ---
# Avec Docker : "http://ollama:11434" (nom du service dans docker-compose)
# Sans Docker : "http://localhost:11434" (Ollama installé en local)
OLLAMA_BASE_URL=http://localhost:11434

# --- API Keys (uniquement si LLM_PROVIDER ≠ ollama) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
MISTRAL_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Installation de modèles Ollama supplémentaires ---
# Séparés par des espaces : "llama3.2 nomic-embed-text"
OLLAMA_EXTRA_MODELS=

# --- SQLite History Database ---
# Chemin vers la base de données SQLite pour l'historique
HISTORY_DB_PATH=data/history.db

# --- Upload PDF ---
PDF_MAX_SIZE_MB=30

# --- Export PDF ---
# Chemin vers wkhtmltopdf (optionnel, utilisé si installé)
# WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf
